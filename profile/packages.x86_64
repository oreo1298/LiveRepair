# Packages installed into the LiveRepair live system.
# Comments start with "#". Dependencies are pulled in automatically.

# ---- Base system and boot loaders
base
linux
mkinitcpio
mkinitcpio-archiso
syslinux
edk2-shell
memtest86+
memtest86+-efi
amd-ucode
intel-ucode
sudo
polkit
bash-completion
less
nano

# ---- Firmware: GPUs, Wi-Fi and Ethernet of desktops and laptops.
# Leaves out the large NVIDIA GSP, server NIC and DSP blobs to keep the ISO small.
linux-firmware-amdgpu
linux-firmware-atheros
linux-firmware-broadcom
linux-firmware-intel
linux-firmware-mediatek
linux-firmware-radeon
linux-firmware-realtek
wireless-regdb

# ---- The LiveRepair applications, built from github.com/oreo1298
cloneandrecover
recoverall
diskhealth
tm5linux
fastcopy-linux-git
linburn
rufux
virtconvert

# ---- Optional dependencies of the applications
# LinBurn (ImgBurnLinux): audio CDs and BIN/CUE, mkisofs, DVD layer break, UDF
cdrdao
cdrtools
dvd+rw-tools
udftools
# CloneAndRecover: zstd images, shrinking exFAT / Btrfs / XFS, health hints
python-zstandard
exfatprogs
btrfs-progs
xfsprogs
smartmontools
# RecoverAll: second recovery engine, software RAID, F2FS and JFS repairs, LUKS/BitLocker
sleuthkit
mdadm
f2fs-tools
jfsutils
cryptsetup
# FastCopyLinux: fastest checksums for Verify
python-xxhash
# DiskHealth: NVMe self-tests
nvme-cli
# VirtConvert and Rufux: formatting new disks and USB drives, unmounting without a password
udisks2
dosfstools
ntfs-3g
ntfsprogs
# Rufux: legacy BIOS boot for Windows installation drives
grub

# ---- Desktop: X11 + LXQt (Qt 6, shared with most applications), the Arch-Colors theme
# (lxqt-themes) and Firefox
xorg-server
xorg-xinit
xorg-xrdb
xorg-setxkbmap
xf86-input-libinput
xf86-video-vesa
lxqt-session
lxqt-panel
lxqt-runner
lxqt-config
lxqt-policykit
lxqt-qtplugin
lxqt-notificationd
lxqt-globalkeys
lxqt-themes
lxqt-sudo
openbox
pcmanfm-qt
gvfs
qterminal
featherpad
firefox
breeze-icons
ttf-dejavu
xdg-utils

# ---- Networking (Wi-Fi setup: "Network Connections" in the panel runs nmtui)
networkmanager
openssh

# ---- Disk, boot and hardware tools
gptfdisk
parted
testdisk
lvm2
hdparm
efibootmgr
usbutils
pciutils
lsscsi
dmidecode
