#!/bin/bash
# Create the passwordless "live" user of the LiveRepair session (runs once per boot,
# before the autologin on tty1). Desktop settings come from /etc/skel.
set -eu

groups=wheel
for g in optical diskhealth; do
    getent group "$g" >/dev/null && groups+=",$g"
done

useradd --create-home --comment "LiveRepair" --groups "$groups" --shell /bin/bash live
passwd --delete live >/dev/null

# Desktop launchers for the LiveRepair applications, straight from their packages
desktop=/home/live/Desktop
install -d -o live -g live "$desktop"
for app in CloneAndRecover RecoverAll DiskHealth ManageDisks Dendro TM5Linux FastCopyLinux LinBurn Rufux VirtConvert; do
    id=io.github.oreo1298.$app
    src=/usr/share/applications/$id.desktop
    [[ -e $src ]] && install -m 0755 -o live -g live "$src" "$desktop/$id.desktop"
done
install -m 0644 -o live -g live /usr/share/liverepair/README.txt "$desktop/README.txt"

# Openbox (the window manager): window borders in the Arch-Colors palette. The first <name> in
# <theme> is the theme; the ones after it are fonts.
if [[ -e /etc/xdg/openbox/rc.xml ]]; then
    install -d -o live -g live /home/live/.config/openbox
    awk '/<theme>/ { theme = 1 }
         theme && /<name>/ { sub(/<name>[^<]*<\/name>/, "<name>LiveRepair-Arch-Colors</name>"); theme = 0 }
         { print }' /etc/xdg/openbox/rc.xml >/home/live/.config/openbox/rc.xml
    chown live:live /home/live/.config/openbox/rc.xml
fi
