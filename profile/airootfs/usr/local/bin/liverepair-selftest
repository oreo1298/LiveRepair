#!/bin/bash
# LiveRepair self-test, used by the ISO's CI boot test. Started by the LXQt session
# (/etc/xdg/autostart), it does nothing unless it is asked for, either by QEMU
# (-fw_cfg name=opt/liverepair/selftest,string=MODE) or on the kernel command line
# (liverepair.selftest or liverepair.selftest=MODE). MODE is:
#   boot   the desktop, the theme and the boot medium (DVD, copy to RAM)
#   full   that, and every application, its tools and services (the default)
# It reports on the first serial port:
#   LIVEREPAIR-SELFTEST: PASS|FAIL|INFO ...   one line per check
#   LIVEREPAIR-SHOT <name>                    a window is open; the host may take a screenshot
#   LIVEREPAIR-SELFTEST: RESULT PASS|FAIL     the end

mode=""
for arg in $(</proc/cmdline); do
    case $arg in
        liverepair.selftest) mode=full ;;
        liverepair.selftest=*) mode=${arg#*=} ;;
    esac
done
if [[ -z $mode ]] && systemd-detect-virt --quiet --vm; then
    cfg=/sys/firmware/qemu_fw_cfg/by_name/opt/liverepair/selftest/raw
    [[ -e $cfg ]] || sudo modprobe qemu_fw_cfg 2>/dev/null
    [[ -e $cfg ]] && mode=$(sudo cat "$cfg" | tr -d '\0\n')
fi
[[ -n $mode ]] || exit 0

failures=0
log=/tmp/liverepair-selftest
mkdir -p "$log"

say() { printf 'LIVEREPAIR-SELFTEST: %s\n' "$*" | sudo tee /dev/ttyS0 >/dev/null; }
shot() { printf 'LIVEREPAIR-SHOT %s\n' "$1" | sudo tee /dev/ttyS0 >/dev/null; sleep 6; }
pass() { say "PASS $*"; }
fail() { say "FAIL $*"; failures=$((failures + 1)); }
# show a command's output on the serial port, indented
dump() { sed 's/^/    | /' "$1" | sudo tee /dev/ttyS0 >/dev/null; }

check() {  # check <name> <command...>: passes if the command exits 0
    local name=$1; shift
    if "$@" >"$log/$name.out" 2>&1; then pass "$name"; else fail "$name (exit $?)"; dump "$log/$name.out"; fi
}

gui() {  # gui <name> <command...>: passes if the program is still running after 20 s
    local name=$1; shift
    "$@" >"$log/$name.out" 2>&1 &
    local pid=$!
    sleep 20
    if kill -0 "$pid" 2>/dev/null; then
        pass "gui $name"
        shot "$name"
        kill "$pid" 2>/dev/null
        sleep 2
        kill -9 "$pid" 2>/dev/null
    else
        wait "$pid"
        fail "gui $name (exited with $?)"
        dump "$log/$name.out"
    fi
    wait "$pid" 2>/dev/null
}

say "START mode=$mode $(tr '\n' ' ' </etc/liverepair-release 2>/dev/null)"
sleep 15                     # let the panel and the desktop settle

# ---- the boot: firmware, boot medium, desktop and theme
if [[ -d /sys/firmware/efi ]]; then say "INFO firmware UEFI"; else say "INFO firmware BIOS"; fi
say "INFO boot medium: $(findmnt -no SOURCE /run/archiso/bootmnt 2>/dev/null || echo 'not mounted')"
say "INFO kernel command line: $(</proc/cmdline)"
if [[ -d /sys/firmware/efi ]]; then
    # the host checks these against how it started the firmware
    sb_state=$(sudo mokutil --sb-state 2>&1)
    case $sb_state in
        *"SecureBoot enabled"*) say "INFO secure boot: enabled" ;;
        *"SecureBoot disabled"*) say "INFO secure boot: disabled" ;;
        *"doesn't support Secure Boot"*) say "INFO secure boot: not supported" ;;
        *) say "INFO secure boot: unknown (${sb_state//$'\n'/ })" ;;
    esac
    [[ -e /usr/share/liverepair/secureboot.cer ]] &&
        say "INFO secure boot key: $(sudo mokutil --test-key /usr/share/liverepair/secureboot.cer 2>&1 | head -n1)"
    say "INFO kernel lockdown: $(sudo cat /sys/kernel/security/lockdown 2>/dev/null || echo unknown)"
fi
if grep -qw copytoram=y /proc/cmdline; then
    # the system runs from RAM and the disc is no longer in use, so the drive can burn discs
    check copytoram-image test -s /run/archiso/copytoram/airootfs.sfs
    check boot-medium-released sh -c '! mountpoint -q /run/archiso/bootmnt'
fi
check session-panel pgrep -u "$USER" -x lxqt-panel
check session-desktop pgrep -u "$USER" -f 'pcmanfm-qt --desktop'
check theme-arch-colors grep -qx 'theme=Arch-Colors' "$HOME/.config/lxqt/lxqt.conf"
check theme-installed test -d /usr/share/lxqt/themes/Arch-Colors
check theme-wallpaper test -s /usr/share/lxqt/wallpapers/plasma_arch.png
# dark mode: Qt programs get the Arch-Colors palette; GTK, libadwaita and Firefox ask the portal
check dark-qt-palette python3 -c '
import sys
from PySide6.QtWidgets import QApplication
app = QApplication(sys.argv)
lightness = app.palette().window().color().lightness()
print("window color lightness", lightness)
sys.exit(0 if lightness < 128 else 1)'
check dark-portal-color-scheme sh -c 'gdbus call --session --dest org.freedesktop.portal.Desktop \
    --object-path /org/freedesktop/portal/desktop --method org.freedesktop.portal.Settings.ReadOne \
    org.freedesktop.appearance color-scheme | tee /dev/stderr | grep -q "uint32 1"'
check dark-libadwaita python3 -c '
import sys, gi
gi.require_version("Gtk", "4.0"); gi.require_version("Adw", "1")
from gi.repository import Adw
Adw.init()
manager = Adw.StyleManager.get_default()
print("follows the desktop:", manager.get_system_supports_color_schemes(), "dark:", manager.get_dark())
sys.exit(0 if manager.get_system_supports_color_schemes() and manager.get_dark() else 1)'
check dark-window-borders grep -q LiveRepair-Arch-Colors "$HOME/.config/openbox/rc.xml"
shot desktop

if [[ $mode == full ]]; then
    # the applications' own checks of what they need
    for doctor in "cnrctl doctor" "recoverctl doctor" "diskctl doctor" "virtconvert doctor"; do
        $doctor >"$log/doctor.out" 2>&1
        rc=$?
        say "INFO $doctor (exit $rc):"
        dump "$log/doctor.out"
    done
    check virtconvert-doctor virtconvert doctor

    # command line tools of the applications and the tools they call
    for tool in cnrctl recoverctl diskctl managedisks managedisks-cli tm5linux-cli fastcopy-linux \
                virtconvert linburn rufux dendro firefox mkfs.hfsplus fsck.hfsplus fsck.hfs mkapfs apfsck \
                ddrescue partclone.ext4 partclone.ntfs rsync smartctl fio nvme qemu-img wimlib-imagex \
                xorriso cdrdao mkisofs growisofs mkudffs grub-install ntfs-3g mkntfs mkfs.exfat mkfs.fat \
                mkfs.btrfs mkfs.xfs mkfs.ext4 fls mdadm cryptsetup fsck.f2fs fsck.jfs udisksctl pkexec \
                sgdisk parted testdisk zstd nmtui mokutil; do
        if command -v "$tool" >/dev/null; then pass "tool $tool"; else fail "tool $tool missing"; fi
    done
    check python-modules python3 -c '
import PySide6.QtWidgets, PySide6.QtSvg, PyQt6.QtWidgets, zstandard, xxhash, gi
gi.require_version("Gtk", "4.0"); gi.require_version("Adw", "1")
from gi.repository import Gtk, Adw'
    check rufux-uefi-ntfs test -s /usr/share/rufux/uefi-ntfs.img
    check tm5-memory-lock sh -c 'getcap /usr/bin/tm5linux-cli | grep -q cap_ipc_lock'
    check dendro-version dendro --version

    # services, privileges and disks
    check service-diskhealthd systemctl is-active --quiet diskhealthd.service
    check service-networkmanager systemctl is-active --quiet NetworkManager.service
    check polkit-no-password pkexec --disable-internal-agent /usr/bin/true
    # Dendro's "Scan as administrator" (its read-only helper, through pkexec)
    check dendro-admin-scan-no-password pkcheck --action-id io.github.oreo1298.Dendro.scan --process $$
    check sudo-no-password sudo -n true
    check udisks udisksctl status
    check no-automount sh -c '! findmnt -rno SOURCE | grep -q "^/dev/[sv]d"'
    for list in "cnrctl list" "recoverctl list" "diskctl list" "virtconvert disks"; do
        # shellcheck disable=SC2086  # "$list" is a command and its argument
        check "${list// /-}" $list
        dump "$log/${list// /-}.out"
    done

    # real work: a TM5 engine self-test, a verified FastCopy copy, and a VirtConvert conversion
    check tm5-engine-selftest tm5linux-cli --selftest
    work=$(mktemp -d)
    mkdir -p "$work/src/sub" "$work/dst"
    head -c 3M /dev/urandom >"$work/src/a.bin"
    echo "LiveRepair self-test" >"$work/src/sub/b.txt"
    check fastcopy-verified-copy sh -c "fastcopy-linux --no-ui --quiet --verify --cmd=force_copy \
        '$work/src/' --to '$work/dst' && diff -r '$work/src' '$work/dst'"
    if qemu-img create -q -f raw "$work/disk.raw" 64M &&
       printf 'LiveRepair self-test\n' | dd of="$work/disk.raw" bs=1 seek=1048576 conv=notrunc status=none &&
       virtconvert convert -q -y -t vhdx -o "$work/disk.vhdx" "$work/disk.raw" >"$log/convert.out" 2>&1 &&
       virtconvert convert -q -y -t vdi -o "$work/disk.vdi" "$work/disk.vhdx" >>"$log/convert.out" 2>&1 &&
       qemu-img compare -q "$work/disk.raw" "$work/disk.vdi" >>"$log/convert.out" 2>&1; then
        pass "virtconvert raw->vhdx->vdi"
    else
        fail "virtconvert raw->vhdx->vdi"
        dump "$log/convert.out"
    fi
    rm -rf "$work"

    # ManageDisks: its own list of filesystems and their tools, then real work on QEMU's empty
    # test disk (only that one, recognised by its serial number): a GPT table with an HFS+ and an
    # APFS partition, which ManageDisks then checks with hfsprogs and apfsprogs
    check managedisks-all-tools sh -c 'managedisks-cli support | tee /dev/stderr |
        grep -q "Every supported filesystem has all of its tools installed"'
    dump "$log/managedisks-all-tools.out"
    if [[ $(lsblk -dno SERIAL /dev/sda 2>/dev/null) == LIVEREPAIR-HD ]]; then
        check managedisks-gpt-table sudo managedisks-cli table --yes /dev/sda gpt
        check managedisks-create-hfsplus sudo managedisks-cli create --yes /dev/sda --size 512M --fs hfsplus --label LR-HFS
        check managedisks-create-apfs sudo managedisks-cli create --yes /dev/sda --size 512M --fs apfs --label LR-APFS
        sudo udevadm settle
        for fs in hfsplus apfs; do
            part=$(lsblk -nrpo NAME,FSTYPE /dev/sda | awk -v fs="$fs" '$2 == fs { print $1; exit }')
            if [[ -n $part ]]; then
                check "managedisks-check-$fs" sudo managedisks-cli check --yes --no-repair "$part"
            else
                fail "managedisks-format-$fs (no $fs partition on /dev/sda)"
            fi
        done
        lsblk -o NAME,SIZE,FSTYPE,LABEL /dev/sda >"$log/lsblk.out" 2>&1
        say "INFO /dev/sda after ManageDisks:"
        dump "$log/lsblk.out"
    fi

    # the desktop launchers and the applications' windows
    for app in CloneAndRecover RecoverAll DiskHealth ManageDisks Dendro TM5Linux FastCopyLinux LinBurn Rufux VirtConvert; do
        check "launcher-$app" test -x "$HOME/Desktop/io.github.oreo1298.$app.desktop"
    done
    gui cloneandrecover cloneandrecover
    gui recoverall recoverall
    gui diskhealth diskhealth
    gui managedisks managedisks
    gui dendro dendro
    gui tm5linux tm5linux
    gui fastcopy-linux fastcopy-linux
    gui linburn linburn
    gui rufux rufux
    gui virtconvert virtconvert
    gui firefox firefox --new-instance about:blank
fi

if (( failures == 0 )); then
    say "RESULT PASS"
else
    say "RESULT FAIL ($failures failed)"
fi
