# Openbox window borders and menus in the colors of LXQt's Arch-Colors palette (LiveRepair).

border.width: 1
padding.width: 4
padding.height: 3
window.handle.width: 0
window.client.padding.width: 0
window.client.padding.height: 0
window.label.text.justify: center

window.active.border.color: #1899da
window.inactive.border.color: #052434
window.active.client.color: #041b27
window.inactive.client.color: #041b27

window.active.title.bg: flat solid
window.active.title.bg.color: #052434
window.inactive.title.bg: flat solid
window.inactive.title.bg.color: #041b27
window.active.label.bg: parentrelative
window.active.label.text.color: #e1e6e6
window.inactive.label.bg: parentrelative
window.inactive.label.text.color: #7c8c96

window.active.button.unpressed.bg: parentrelative
window.active.button.unpressed.image.color: #e1e6e6
window.active.button.hover.bg: flat solid
window.active.button.hover.bg.color: #1899da
window.active.button.hover.image.color: #ffffff
window.active.button.pressed.bg: flat solid
window.active.button.pressed.bg.color: #0f6fa3
window.active.button.pressed.image.color: #ffffff
window.active.button.disabled.bg: parentrelative
window.active.button.disabled.image.color: #4a5a64
window.inactive.button.unpressed.bg: parentrelative
window.inactive.button.unpressed.image.color: #7c8c96
window.inactive.button.hover.bg: flat solid
window.inactive.button.hover.bg.color: #1899da
window.inactive.button.hover.image.color: #ffffff
window.inactive.button.pressed.bg: flat solid
window.inactive.button.pressed.bg.color: #0f6fa3
window.inactive.button.pressed.image.color: #ffffff
window.inactive.button.disabled.bg: parentrelative
window.inactive.button.disabled.image.color: #4a5a64

window.active.handle.bg: flat solid
window.active.handle.bg.color: #052434
window.inactive.handle.bg: flat solid
window.inactive.handle.bg.color: #041b27
window.active.grip.bg: flat solid
window.active.grip.bg.color: #052434
window.inactive.grip.bg: flat solid
window.inactive.grip.bg.color: #041b27

menu.border.width: 1
menu.border.color: #1899da
menu.title.bg: flat solid
menu.title.bg.color: #052434
menu.title.text.color: #e1e6e6
menu.title.text.justify: center
menu.items.bg: flat solid
menu.items.bg.color: #041b27
